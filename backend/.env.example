# ==============================================================
# CLEARTERM AI — ENVIRONMENT CONFIGURATION
# ==============================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your_random_secret_key_here

# Google Gemini API
# Required for multimodal document extraction (Screen 3)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox REST API Credentials
# Required for Catalog Products, Billing Plans and Subscriptions
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_RETURN_URL=http://localhost:3000/app/consent?paypal=return
PAYPAL_CANCEL_URL=http://localhost:3000/app/consent?paypal=cancel

# Storage and Rate Limiting
MAX_CONTENT_LENGTH=10485760 # 10 MB limit
RATELIMIT_DEFAULT=100 per minute

